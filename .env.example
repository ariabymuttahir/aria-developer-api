# ---- ARIA Developer API : environment template ----
# Copy to .env for local runs. On Render/Railway, paste these as env vars instead.

PORT=8787

# Storage: "memory" for local tests. Leave unset in production and provide
# FIREBASE_SERVICE_ACCOUNT_JSON so the server uses your real Firestore.
STORE=memory
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}   # whole JSON on ONE line

# Owner backdoor for local testing / scripts (also used if firebase-admin
# has no credentials). The admin PANEL uses Firebase login instead.
ADMIN_SECRET=change-me-to-something-long-and-random

# AI provider keys — server side only.
# OPTION 1 (recommended): leave these EMPTY. The server reads your keys
# automatically from Firestore `config/api_keys` — the same keys you saved
# in the admin panel's API Keys page. Rotate a key in the panel and the
# developer API picks it up within ~5 minutes. No redeploy needed.
# OPTION 2: set them here to override Firestore.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=

# Optional model overrides
# GEMINI_MODEL=gemini-2.0-flash
# DEEPSEEK_MODEL=deepseek-chat
# MISTRAL_MODEL=mistral-large-latest
# OPENAI_MODEL=gpt-4o-mini

# Local test mode: PROVIDER_MODE=stub answers without calling any provider
# and without needing keys. NEVER use stub in production.
PROVIDER_MODE=stub

# Comma-separated origins allowed to call the API from browsers. Default "*".
CORS_ORIGINS=*

# Optional: extra Firebase UIDs always treated as owner for /admin/*
# OWNER_UIDS=uid1,uid2
